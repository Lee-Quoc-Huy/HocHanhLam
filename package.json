{
  "name": "linguaverse-ai",
  "version": "0.1.0",
  "private": true,
  "description": "LinguaVerse AI — AI-powered personal language learning management platform (EN / KR / ZH)",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.types.ts"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",

    "@supabase/supabase-js": "2.48.1",
    "@supabase/ssr": "0.5.2",

    "@tanstack/react-query": "5.62.11",
    "@tanstack/react-query-devtools": "5.62.11",
    "zustand": "5.0.2",

    "tailwindcss": "3.4.17",
    "postcss": "8.5.1",
    "autoprefixer": "10.4.20",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",

    "framer-motion": "11.15.0",
    "next-themes": "0.4.4",

    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@radix-ui/react-popover": "1.1.4",

    "lucide-react": "0.469.0",
    "react-hook-form": "7.54.2",
    "@hookform/resolvers": "3.9.1",
    "zod": "3.24.1",

    "next-pwa": "5.6.0",
    "idb": "8.0.1",

    "date-fns": "4.1.0",
    "sonner": "1.7.2"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "husky": "9.1.7",
    "lint-staged": "15.3.0",
    "supabase": "1.226.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
