# ==========================================
# Học Hành Lắm 🍃 — Local Development Environment Template
# ==========================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# ---- Auth ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI Providers (via OpenRouter gateway) ----
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing defaults (can be overridden per feature at call time)
AI_MODEL_CHAT_DEFAULT=google/gemini-2.5-flash
AI_MODEL_CHAT_REASONING=deepseek/deepseek-r1
AI_MODEL_CHAT_FAST=qwen/qwen-2.5-7b-instruct
AI_MODEL_VISION_OCR=google/gemini-2.5-pro
AI_MODEL_EMBEDDING=text-embedding-3-large

# ---- Google AI Studio (dùng riêng cho tính năng Đọc Ảnh AI — tách khỏi OpenRouter) ----
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key-here
# Model đọc ảnh — có thể đổi nếu Google cập nhật tên model
GOOGLE_AI_IMAGE_MODEL=gemini-3.5-flash-late

# ---- Feature flags ----
NEXT_PUBLIC_ENABLE_PWA=true

# Cloudflare R2 (lưu trữ tệp trong Thư Viện — miễn phí tới 10GB/tháng)
# CLOUDFLARE_R2_ACCOUNT_ID chấp nhận cả 2 dạng:
#   - chỉ account ID: eec1498b59d592a9d2cc3bf6c0e39eb6
#   - hoặc endpoint đầy đủ: https://eec1498b59d592a9d2cc3bf6c0e39eb6.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCOUNT_ID=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=hoc-hanh-lam-library
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
