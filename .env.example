# =========================================================
# DB CHÍNH — Supabase (auth + tiến độ người dùng)
# Lấy tại: Supabase Dashboard > Project Settings > API
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
# Lấy tại: Supabase Dashboard > Project Settings > API > "service_role" (secret)
# TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_ vào biến này — nó có toàn quyền
# trên database, chỉ được dùng ở server (xem lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# =========================================================
# DB PHỤ — Neon (nội dung tĩnh: câu hỏi trò chơi, từ điển mẫu)
# Lấy tại: Neon Console > Connection string (chọn "Pooled connection")
# =========================================================
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/langverse?sslmode=require

# =========================================================
# AI — Google AI Studio (Gemini) — miễn phí, lấy tại https://aistudio.google.com/apikey
# =========================================================
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_FLASH_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_EXERCISE=gemini-2.5-flash

# =========================================================
# AI — Groq — miễn phí, lấy tại https://console.groq.com/keys
# Kiểm tra tên model mới nhất tại https://console.groq.com/docs/models
# =========================================================
GROQ_API_KEY=
GROQ_MODEL_SCOUT=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_INSTANT=llama-3.1-8b-instant
GROQ_MODEL_QWEN=qwen/qwen3-32b

# =========================================================
# AI — OpenRouter — có model miễn phí (hậu tố ":free"), chạy bình thường
# trên Vercel vì là dịch vụ cloud (khác Ollama). Lấy key tại
# https://openrouter.ai/keys — kiểm tra danh sách model free mới nhất tại
# https://openrouter.ai/models?max_price=0
# =========================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL_LLAMA=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_GEMMA=google/gemma-2-9b-it:free
OPENROUTER_MODEL_QWEN=qwen/qwen-2.5-7b-instruct:free
# Dùng cho header HTTP-Referer khi gọi OpenRouter (không bắt buộc)
NEXT_PUBLIC_SITE_URL=

# =========================================================
# Cloudflare R2 (lưu trữ tài liệu — sheet gốc, ảnh gốc người dùng tải lên)
# Lấy tại: Cloudflare Dashboard > R2 > Manage API Tokens
# Chưa được nối trong bản này — điền sẵn để dùng khi mở rộng tính năng
# lưu file gốc thay vì chỉ lưu dữ liệu đã trích xuất.
# =========================================================
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=langverse-documents
